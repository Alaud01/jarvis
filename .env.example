OPENROUTER_API_KEY=
TAVILY_KEY=
OPENCODE_GO_API_KEY=

# Optional provider settings
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=
OPENROUTER_TITLE=Jarvis
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_INCLUDE_CLOUD_MODELS=true
OLLAMA_API_KEY=

# Optional voice service settings
VOICE_SERVICE_PORT=8765
OPENROUTER_TRANSCRIPTION_MODEL=nvidia/parakeet-tdt-0.6b-v3
OPENROUTER_REFINEMENT_MODEL=openai/gpt-oss-120b
OPENROUTER_REFINEMENT_REASONING_EFFORT=low
OPENROUTER_REFINEMENT_MIN_THROUGHPUT=200
OPENROUTER_REFINEMENT_DISAMBIGUATION_HINT_CHARS=80
VOICE_LOCAL_PARAKEET_ENABLED=true
VOICE_LOCAL_PARAKEET_MODEL=nvidia/parakeet-tdt_ctc-110m
VOICE_LOCAL_PARAKEET_DEVICE=mps
VOICE_LOCAL_PARAKEET_PRELOAD_ENABLED=true
VOICE_LOCAL_PARAKEET_COLD_START_BUDGET_SECONDS=90
VOICE_LOCAL_PARAKEET_TIMEOUT_FALLBACK_ENABLED=false
VOICE_LOCAL_PARAKEET_IDLE_UNLOAD_SECONDS=600
# Electron client abort for /process-flow and /transcribe-only (must exceed cold-start budget)
VOICE_PROCESS_FLOW_TIMEOUT_MS=150000

# Set to 1 to keep Jarvis on its own private Codex login instead of following Codex Switcher.
JARVIS_CODEX_PRIVATE_AUTH=
