{
  "name": "jarvis",
  "version": "1.0.0",
  "description": "macOS menu bar AI assistant with chat, voice dictation, search, Notion tools, and browser control",
  "main": "dist/main/index.js",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "compile": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "setup:python": "cd python-service && python3 -m venv venv && PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 venv/bin/python -m pip install -q -r requirements.txt",
    "test:js": "node tests/voiceLearning.test.js",
    "test:python": "cd python-service && if [ ! -d venv ]; then python3 -m venv venv; fi && PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 venv/bin/python -m pip install -q -r requirements.txt && venv/bin/python -m unittest discover -s .",
    "test": "pnpm compile && pnpm test:js && pnpm test:python",
    "dev": "pnpm dev:all",
    "build": "pnpm compile && pnpm build:renderer && electron-builder",
    "start": "pnpm compile && pnpm build:renderer && electron .",
    "dev:all": "concurrently \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.node.json && wait-on http://localhost:5174 && electron .",
    "start:python": "cd python-service && if [ ! -d venv ]; then python3 -m venv venv; fi && PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 venv/bin/python -m pip install -q -r requirements.txt && venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port ${VOICE_SERVICE_PORT:-8765} --reload"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.44",
    "officeparser": "^7.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.1.0",
    "electron": "^41.8.0",
    "electron-builder": "^26.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.jarvis.app",
    "files": [
      "assets/**/*",
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python-service",
        "to": "python-service",
        "filter": [
          "**/*",
          "!venv/**",
          "!__pycache__/**",
          "!.pytest_cache/**",
          "!*.pyc"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    }
  }
}
